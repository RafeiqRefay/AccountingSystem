{
  "name": "MyApp",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "Accounting and Inventory Management System",
  "author": "Digital Software",

  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },

  "dependencies": {
    "axios": "^1.16.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.0.0",
    "react-select": "^5.10.0"
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "vite": "^6.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },

  "build": {
    "appId": "com.eastgallery.app",
    "productName": "محاسب",
    "copyright": "Copyright © 2026 Digital Software",

    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.ico",
      "package.json"
    ],

    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],

    "directories": {
      "output": "dist-installer"
    },

    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",

      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,

      "allowToChangeInstallationDirectory": true,

      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,

      "shortcutName": "محاسب",

      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",

      "artifactName": "${productName}.${ext}"
    }
  }
}